# Copy this file to .env.local and fill in real values for production.
# Every variable below is optional — the site runs fully in demo mode
# without any of them configured (see SETUP.md).

# --- Firebase (Firestore) ---------------------------------------------
# Create a project at https://console.firebase.google.com, add a Web app,
# and copy its config values here. Leaving these unset keeps all form
# submissions in the browser's localStorage instead.
NEXT_PUBLIC_FB_API_KEY=
NEXT_PUBLIC_FB_AUTH_DOMAIN=
NEXT_PUBLIC_FB_PROJECT_ID=
NEXT_PUBLIC_FB_STORAGE_BUCKET=
NEXT_PUBLIC_FB_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FB_APP_ID=

# --- Payment provider ---------------------------------------------------
# Set to a provider name (e.g. "stripe") once src/lib/payment.ts has a real
# implementation wired up. Leaving this unset keeps checkout in simulated
# demo mode — no real transaction is ever created.
NEXT_PUBLIC_PAYMENT_PROVIDER=

# --- Espace Y presentation mode -----------------------------------------
# When true, the "Entente à discuter" financial sections are always shown
# on the Élite/École/Corpo pages. Leave this false in production — the
# ?presentation=espace-y URL parameter can enable it temporarily instead.
NEXT_PUBLIC_SHOW_ESPACE_Y_DEALS=false
